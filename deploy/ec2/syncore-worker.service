[Unit]
Description=Syncore background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=HOME=/tmp
Environment=XDG_CACHE_HOME=/tmp/syncore-worker-cache
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/syncore/worker.env
ExecStart=/usr/bin/bash -lc 'npm run worker:background -- --loop "${SYNCORE_WORKER_LOOP_MS:-60000}"'
Restart=always
RestartSec=10
# The notify worker finishes its one in-flight HTTP attempt (default timeout 15s),
# then leaves the remaining rows unclaimed. A hard kill is recovered by lease expiry.
TimeoutStopSec=30
KillSignal=SIGINT
# Memory guard — see syncore-web.service. The worker peaked ~970M during the
# full-projection-on-read incident; cap it below that co-peak so web + worker can
# never again sum past instance RAM. Kept in the repo so a rebuild can't drop it.
MemoryHigh=700M
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/tmp /var/tmp

[Install]
WantedBy=multi-user.target
