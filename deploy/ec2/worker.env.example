# Copy this file to /etc/syncore/worker.env on the EC2 worker.
# Do not commit real production secrets.

DATABASE_URL="postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/syncore?sslmode=require"
# Prisma is the only storage driver (file driver removed in the blob migration).
SYNCORE_STORAGE_DRIVER="prisma"
SYNCORE_SEED_SNAPSHOT="false"
# Only changed rows are re-projected per write (matches the web unit — keep in sync).
SYNCORE_PROJECTION_MODE="diff"

SYNCORE_AUTH_SECRET="replace-with-the-same-production-auth-secret-matching-the-web-app"
SYNCORE_WEBHOOK_SECRET="replace-with-provider-shared-secret"
SYNCORE_CREDENTIAL_ENCRYPTION_KEY="replace-with-the-same-production-credential-encryption-key-matching-the-web-app"
SYNCORE_CREDENTIAL_KEY_ID="production-key"
SYNCORE_APP_URL="https://app.your-domain.com"
SYNCORE_ENABLE_LIVE_PROVIDERS="true"
SYNCORE_WORKER_LOOP_MS="60000"
# Dead-man-switch heartbeat (healthchecks.io-style check URL). The worker pings it
# after every successful tick and <url>/fail on a failed one; the external monitor
# alerts when pings stop. Unset = no-op. See lib/phase1/worker-heartbeat.ts.
# SYNCORE_WORKER_HEARTBEAT_URL="https://hc-ping.com/your-check-uuid"

# Growth OS CRM -> Growth Bot durable NotifyOutbox delivery.
SYNCORE_BOT_NOTIFY_URL="https://growth-bot.your-domain.com/notify"
# Same bytes as the Bot's SYNCORE_BOT_NOTIFY_SIGNING_KEY and the web service value.
SYNCORE_BOT_NOTIFY_SECRET="replace-with-growth-bot-notify-signing-secret"
SYNCORE_BOT_NOTIFY_TIMEOUT_MS="15000"
SYNCORE_BOT_NOTIFY_LEASE_MS="60000"
SYNCORE_BOT_NOTIFY_MAX_ATTEMPTS="8"
SYNCORE_BOT_NOTIFY_RETRY_BASE_MS="60000"
SYNCORE_BOT_NOTIFY_RETRY_MAX_MS="3600000"
SYNCORE_BOT_NOTIFY_BATCH_SIZE="25"

SYNCORE_MAILING_ADDRESS="Syncore Tech, 1500 N Grant St, Denver, CO 80203, USA"
# MUST be a lookalike-domain mailbox — live cold sends from syncoretech.com are
# refused (golden rule 13; see lib/phase1/outreach-validation.ts).
SYNCORE_OUTREACH_FROM="Bobby Jones <bobby@your-lookalike-domain.com>"
SYNCORE_OUTREACH_REPLY_TO="replies@your-lookalike-domain.com"
# Domains a REP may send their own direct/bulk email from (comma separated).
# Defaults to syncoretech.com, which means live COLD first touches are refused
# under golden rule 13 — set this to your lookalike domain and move the reps
# User.email onto it to enable SDR cold sending. Warm replies to already-emailed
# contacts are unaffected either way.
SYNCORE_ALLOWED_SENDER_DOMAINS="your-lookalike-domain.com"
SYNCORE_UNSUBSCRIBE_SECRET="replace-with-the-same-production-unsubscribe-secret-matching-the-web-app"
SYNCORE_OUTREACH_BATCH_SIZE="50"

APOLLO_API_KEY="replace-with-apollo-api-key"
GOOGLE_PLACES_API_KEY="replace-with-google-places-api-key"
APIFY_TOKEN="replace-with-apify-token"
HUNTER_API_KEY="replace-with-hunter-api-key"
ZEROBOUNCE_API_KEY="replace-with-zerobounce-api-key"
TWILIO_ACCOUNT_SID="replace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
RINGCENTRAL_CLIENT_ID="replace-with-ringcentral-client-id"
RINGCENTRAL_CLIENT_SECRET="replace-with-ringcentral-client-secret"
RINGCENTRAL_JWT="replace-with-ringcentral-jwt"
RINGCENTRAL_SERVER_URL="https://platform.ringcentral.com"
SYNCORE_RINGCENTRAL_SAM_PHONE_NUMBER="replace-with-sam-ringcentral-number"
SMARTLEAD_API_KEY="replace-with-smartlead-api-key"
AWS_SES_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
