# Copy this file to /etc/syncore/web.env on the EC2 instance (chmod 600).
# The web app + the background worker run on the SAME instance (lean stack) and
# share the same secrets; the worker additionally sets SYNCORE_WORKER_LOOP_MS.
# Do not commit real production secrets — source these from SSM Parameter Store.

# --- Database (AWS RDS PostgreSQL, direct connection — NO pgbouncer/proxy) ---
DATABASE_URL="postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/syncore?sslmode=require"
# Prisma is the only storage driver (the file driver was removed in the blob
# migration). Any other value fails loudly at startup.
SYNCORE_STORAGE_DRIVER="prisma"
SYNCORE_SEED_SNAPSHOT="false"
# Only changed rows are re-projected per write — cuts DB write I/O ~1-2 orders of
# magnitude so a db.t4g.micro copes with the whole-blob write pattern.
SYNCORE_PROJECTION_MODE="diff"

# --- App secrets — for a MIGRATION, REUSE the current prod values (do NOT
# regenerate): SYNCORE_CREDENTIAL_ENCRYPTION_KEY decrypts already-encrypted
# provider credentials in the migrated DB. See docs/AWS_MIGRATION.md. Store in SSM. ---
SYNCORE_AUTH_SECRET="replace-with-strong-random-auth-session-secret"
SYNCORE_WEBHOOK_SECRET="replace-with-provider-shared-secret"
SYNCORE_CREDENTIAL_ENCRYPTION_KEY="replace-with-strong-random-credential-encryption-key"
SYNCORE_CREDENTIAL_KEY_ID="production-key"
SYNCORE_UNSUBSCRIBE_SECRET="replace-with-strong-random-unsubscribe-hmac-secret"
# Absolute base URL for invite/reset/one-click-unsubscribe links (the new AWS domain).
SYNCORE_APP_URL="https://app.your-domain.com"

# Growth OS chat intake and durable CRM -> Bot notifications. The web process
# signs/enqueues; the worker re-signs the same body bytes for each attempt.
SYNCORE_CHAT_API_TOKEN="replace-with-strong-random-chat-api-token"
SYNCORE_BOT_NOTIFY_URL="https://growth-bot.your-domain.com/notify"
# Same bytes as the Bot's SYNCORE_BOT_NOTIFY_SIGNING_KEY and worker service value.
SYNCORE_BOT_NOTIFY_SECRET="replace-with-growth-bot-notify-signing-secret"
SYNCORE_HUB_URL="https://lead-hub.your-domain.com"
SYNCORE_BOT_NOTIFY_TIMEOUT_MS="15000"
SYNCORE_BOT_NOTIFY_LEASE_MS="60000"
SYNCORE_BOT_NOTIFY_MAX_ATTEMPTS="8"
SYNCORE_BOT_NOTIFY_RETRY_BASE_MS="60000"
SYNCORE_BOT_NOTIFY_RETRY_MAX_MS="3600000"
SYNCORE_BOT_NOTIFY_BATCH_SIZE="25"

# --- Providers / outreach ---
SYNCORE_ENABLE_LIVE_PROVIDERS="true"
SYNCORE_MAILING_ADDRESS="Syncore Tech, 1500 N Grant St, Denver, CO 80203, USA"
# MUST be a lookalike-domain mailbox — live cold sends from syncoretech.com are
# refused (golden rule 13; see lib/phase1/outreach-validation.ts).
SYNCORE_OUTREACH_FROM="Bobby Jones <bobby@your-lookalike-domain.com>"
SYNCORE_OUTREACH_REPLY_TO="replies@your-lookalike-domain.com"
SYNCORE_OUTREACH_BATCH_SIZE="50"
AWS_SES_REGION="us-east-1"
# Prefer the instance IAM role for SES (leave these unset once the SES adapter
# supports the default credential chain — see AWS_MIGRATION.md Phase 6 follow-up).
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
APOLLO_API_KEY="replace-with-apollo-api-key"
HUNTER_API_KEY="replace-with-hunter-api-key"
APIFY_TOKEN="replace-with-apify-token"
RINGCENTRAL_CLIENT_ID="replace-with-ringcentral-client-id"
RINGCENTRAL_CLIENT_SECRET="replace-with-ringcentral-client-secret"
RINGCENTRAL_JWT="replace-with-ringcentral-jwt"
RINGCENTRAL_SERVER_URL="https://platform.ringcentral.com"
SYNCORE_RINGCENTRAL_SAM_PHONE_NUMBER="replace-with-sam-ringcentral-number"
