DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_engine_crm"
SYNCORE_STORAGE_DRIVER="prisma"
SYNCORE_ALLOW_FILE_STORAGE_IN_PRODUCTION="false"
# "diff" (default) upserts only the rows each action changed; "full" re-syncs every
# row of a write's scoped tables (slower, fully self-healing). diff is proven in
# prod (the Neon-egress fix) and equivalence-tested; set "full" only to fall back.
SYNCORE_PROJECTION_MODE="diff"
# When "true", permits seeding the demo snapshot: the seed-prisma script runs AND
# the read path may auto-seed an empty store. Keep "false" in production so a fresh
# or wiped database fails closed instead of recreating the seeded demo workspace
# (which ships a well-known superadmin). Provisioning seeds explicitly regardless.
SYNCORE_SEED_SNAPSHOT="false"
SYNCORE_AUTH_SECRET="replace-with-strong-random-auth-session-secret"
SYNCORE_ALLOW_DEMO_SESSION="false"
SYNCORE_WEBHOOK_SECRET="replace-with-provider-shared-secret"
SYNCORE_CREDENTIAL_ENCRYPTION_KEY="replace-with-strong-random-credential-encryption-key"
SYNCORE_CREDENTIAL_KEY_ID="local-development-key"
SYNCORE_APP_URL="http://localhost:3000"
SYNCORE_ENABLE_LIVE_PROVIDERS="false"
SYNCORE_MAILING_ADDRESS="Syncore Tech, 1500 N Grant St, Denver, CO 80203, USA"
SYNCORE_OUTREACH_FROM="Bobby Jones <bobby@syncoretech.com>"
SYNCORE_OUTREACH_REPLY_TO="replies@syncoretech.com"
# Domains a REP may send their own direct/bulk email from (comma separated).
# Defaults to syncoretech.com, which means live COLD first touches are refused
# under golden rule 13 — set this to your lookalike domain and move the reps
# User.email onto it to enable SDR cold sending. Warm replies to already-emailed
# contacts are unaffected either way.
# NOTE: "already-emailed" means an email this CRM sent (a Sent event attested to
# Amazon SES). Contacts worked through Mailshake carry no such event here, so a
# CRM follow-up to them reads as cold touch 1 and is refused until this is set.
SYNCORE_ALLOWED_SENDER_DOMAINS="your-lookalike-domain.com"
SYNCORE_UNSUBSCRIBE_SECRET="replace-with-strong-random-unsubscribe-hmac-secret"
SYNCORE_OUTREACH_BATCH_SIZE="50"
# "true" enables the durable send outbox: a "Sending" claim is written before each
# live 1:1 email/SMS send so a retry with the same request cannot double-send, and
# an interrupted send leaves a visible "Sending" record. Default off = send-then-record.
SYNCORE_OUTREACH_OUTBOX="false"
SYNCORE_PERF_LOGS="false"
SYNCORE_PERF_SLOW_MS="2500"
SYNCORE_WORKER_LOOP_MS="60000"
# Optional dead-man-switch heartbeat for the background worker. Set to a
# healthchecks.io-style check URL: the worker POSTs it after every successful tick,
# and POSTs <url>/fail (with the error) on a tick failure — so a crashed / wedged /
# crash-looping worker alerts instead of dying silently. Unset = no monitoring.
SYNCORE_WORKER_HEARTBEAT_URL=""

# --- Growth OS chat + notification delivery ---
# Dashboard/chat API bearer token (CRM inbound routes).
SYNCORE_CHAT_API_TOKEN="replace-with-strong-random-chat-api-token"
# Exact Growth Bot /notify endpoint. Production delivery requires HTTPS.
SYNCORE_BOT_NOTIFY_URL="http://localhost:3100/notify"
# Shared HMAC key; set the same bytes as the Growth Bot's
# SYNCORE_BOT_NOTIFY_SIGNING_KEY. Required by both web enqueue and worker retry.
SYNCORE_BOT_NOTIFY_SECRET="replace-with-strong-random-bot-notify-signing-secret"
# One row is leased at a time. Keep lease > timeout and systemd TimeoutStopSec > timeout.
SYNCORE_BOT_NOTIFY_TIMEOUT_MS="15000"
SYNCORE_BOT_NOTIFY_LEASE_MS="60000"
SYNCORE_BOT_NOTIFY_MAX_ATTEMPTS="8"
SYNCORE_BOT_NOTIFY_RETRY_BASE_MS="60000"
SYNCORE_BOT_NOTIFY_RETRY_MAX_MS="3600000"
SYNCORE_BOT_NOTIFY_BATCH_SIZE="25"
# Lead Hub launch target; no Hub sync is implemented in Wave 1.
SYNCORE_HUB_URL="http://localhost:3200"

APOLLO_API_KEY="replace-with-apollo-api-key"
GOOGLE_PLACES_API_KEY="replace-with-google-places-api-key"
APIFY_TOKEN="replace-with-apify-token"
HUNTER_API_KEY="replace-with-hunter-api-key"
ZEROBOUNCE_API_KEY="replace-with-zerobounce-api-key"
TWILIO_ACCOUNT_SID="replace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
RINGCENTRAL_CLIENT_ID="replace-with-ringcentral-client-id"
RINGCENTRAL_CLIENT_SECRET="replace-with-ringcentral-client-secret"
RINGCENTRAL_JWT="replace-with-ringcentral-jwt"
RINGCENTRAL_SERVER_URL="https://platform.ringcentral.com"
SYNCORE_RINGCENTRAL_SAM_PHONE_NUMBER="replace-with-sam-ringcentral-number"
SMARTLEAD_API_KEY="replace-with-smartlead-api-key"
AWS_SES_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"

# SES bounce/complaint webhook (delivered via SNS).
# Allow-list of your own SES->SNS topic ARN(s), comma-separated. When set, the
# webhook rejects (403) any message from a different topic even if it is validly
# AWS-signed — this is the fix for forged cross-tenant suppression. When UNSET the
# webhook FAILS CLOSED in production (rejects every topic) and stays permissive in
# dev; set it to your SES->SNS topic ARN(s) in production.
SYNCORE_SES_TOPIC_ARNS=""
# Optional shared token appended to the webhook URL (?token=...) for defense-in-depth.
SYNCORE_SES_WEBHOOK_TOKEN=""
# Untagged SES events (no syncore_workspace_id tag) are QUARANTINED by default
# rather than applied to the first email match across all tenants (which a forged or
# mis-tagged event could abuse). Set to "false" to restore the legacy cross-tenant
# first-match. Tagged events are always scoped to their own workspace.
SYNCORE_SES_QUARANTINE_UNSCOPED="true"
