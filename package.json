{
  "name": "lead-engine-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:bootstrap": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run db:seed",
    "db:seed": "tsx scripts/seed-prisma.ts",
    "db:reproject": "tsx scripts/reproject.ts",
    "db:provision": "tsx scripts/provision-workspace.ts",
    "generate-secrets": "tsx scripts/generate-secrets.ts",
    "worker:provider": "tsx scripts/run-provider-worker.ts",
    "worker:lead": "tsx scripts/run-lead-worker.ts",
    "worker:background": "tsx scripts/run-background-worker.ts",
    "worker:recording": "tsx scripts/run-recording-worker.ts",
    "validate-adapter": "tsx scripts/validate-adapter.ts",
    "providers:status": "tsx scripts/providers-status.ts",
    "db:migrate:status": "prisma migrate status",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1075.0",
    "@fontsource/manrope": "^5.2.8",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "gridstack": "^12.6.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "ringcentral-web-phone": "^2.4.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
