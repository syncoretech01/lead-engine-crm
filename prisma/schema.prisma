  owner               String?
  verification        String?
  enrichmentCoverage  Int?
  fitReason           String?
  notes               String?
  enrichedAt          DateTime?
  lawfulBasis         String?
  consentStatus       String?
  consentSource       String?
  consentCapturedAt   DateTime?
