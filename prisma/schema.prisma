generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppStateSnapshot {
  id        String   @id
  version   Int
  state     Json
  // Optimistic-concurrency counter: bumped on every transactional write via a
  // compare-and-set (updateMany where writeSeq = readValue). A concurrent commit
  // moves it, so the losing writer matches 0 rows, throws, and retries against the
  // now-current state instead of silently overwriting the winner. See store.ts.
  writeSeq  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WorkspaceRole {
  ADMIN
  MANAGER
  SDR
  DATA_OPERATOR
  VIEWER
  COMPLIANCE_ADMIN
}

enum JobStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ProcessingStatus {
  PENDING
  NORMALIZED
  FAILED
  SUPPRESSED
}

enum VerificationGrade {
  A
  B
  C
  D
  S
}

enum PriorityTier {
  P1
  P2
  P3
  P4
  S
}

enum OpportunityStage {
  PROSPECTING
  QUALIFIED
  DISCOVERY
  PROPOSAL
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  EMAIL
  CALL
  SMS
  NOTE
  TASK
  MEETING
  STATUS_CHANGE
  VERIFICATION
  OPPORTUNITY
}

enum SuppressionType {
  UNSUBSCRIBE
  HARD_BOUNCE
  DO_NOT_CALL
  EXISTING_CUSTOMER
  COMPETITOR
  SPAM_COMPLAINT
  SMS_OPT_OUT
  INTERNAL
  DISQUALIFIED
  DELETION_REQUEST
}

model Workspace {
  id                              String                           @id @default(cuid())
  name                            String
  market                          String?
  seats                           Int                              @default(0)
  health                          String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  members                         WorkspaceMember[]
  authSessions                    AuthSession[]
  userInvites                     UserInvite[]
  integrations                    Integration[]
  providerConnections             ProviderConnection[]
  providerCredentialAudits        ProviderCredentialAudit[]
  providerEncryptedSecrets        ProviderEncryptedSecret[]
  providerJobs                    ProviderJob[]
  providerJobRuns                 ProviderJobRun[]
  providerUsageLedger             ProviderUsageLedger[]
  providerMetricsDaily            ProviderMetricDaily[]

  // --- Growth OS (CRM-1) --------------------------------------------------
  // Spend thresholds for the approval gates (v9.1 §10). At or above T2 a second
  // distinct approver is required before an approval reaches `approved`; below
  // T1 any authorized approver may decide alone. Null T2 disables the
  // two-person rule for the workspace.
  approvalThresholdT1Cents        Int                              @default(0)
  approvalThresholdT2Cents        Int?
  nicheRequests                   NicheRequest[]
  researchRuns                    ResearchRun[]
  nicheBriefs                     NicheBrief[]
  campaigns                       Campaign[]
  campaignStageRuns               CampaignStageRun[]
  approvals                       Approval[]
  costEntries                     CostEntry[]
  // ------------------------------------------------------------------------
  searchProfiles                  SearchProfile[]
  leadJobs                        LeadJob[]
  asyncJobRuns                    AsyncJobRun[]
  jobLogs                         JobLog[]
  jobIdempotencyRecords           JobIdempotencyRecord[]
  rawLeads                        RawLead[]
  normalizedRecords               NormalizedRecord[]
  companies                       Company[]
  contacts                        Contact[]
  fieldSources                    FieldSource[]
  verificationResults             VerificationResult[]
  enrichmentResults               EnrichmentResult[]
  providerCacheEntries            ProviderCacheEntry[]
  segments                        Segment[]
  recordSegments                  RecordSegment[]
  leadScores                      LeadScore[]
  dedupeMatches                   DedupeMatch[]
  exportRules                     ExportRule[]
  exports                         Export[]
  accounts                        Account[]
  opportunities                   Opportunity[]
  activities                      Activity[]
  tasks                           Task[]
  notes                           Note[]
  callLogs                        CallLog[]
  customFields                    CustomField[]
  customFieldValues               CustomFieldValue[]
  sdrTeams                        SdrTeam[]
  sdrAssignments                  SdrAssignment[]
  followUpReminders               FollowUpReminder[]
  reassignmentRules               ReassignmentRule[]
  outreachProviders               OutreachProvider[]
  outreachCampaigns               OutreachCampaign[]
  campaignSequences               CampaignSequence[]
  sequenceSteps                   SequenceStep[]
  emailEvents                     EmailEvent[]
  smsEvents                       SmsEvent[]
  webhookEvents                   WebhookEvent[]
  trackedCalls                    TrackedCall[]
  sdrCallingSessions              SdrCallingSession[]
  sdrDailyReports                 SdrDailyReport[]
  reportSnapshots                 ReportSnapshot[]
  retentionPolicies               RetentionPolicy[]
  retentionRuns                   RetentionRun[]
  complianceChecklistItems        ComplianceChecklistItem[]
  dataSubjectRequests             DataSubjectRequest[]
  deliverabilityAlerts            DeliverabilityAlert[]
  aiPersonalizations              AiPersonalization[]
  aiReplyClassifications          AiReplyClassification[]
  aiCallSummaries                 AiCallSummary[]
  aiLeadScorePredictions          AiLeadScorePrediction[]
  aiIcpRecommendations            AiIcpRecommendation[]
  aiDeliverabilityRecommendations AiDeliverabilityRecommendation[]
  aiRevenueInsights               AiRevenueInsight[]
  aiAutomationRuns                AiAutomationRun[]
  waterfallTemplates              WaterfallTemplate[]
  suppressionRecords              SuppressionRecord[]
  auditLogs                       AuditLog[]
}

model User {
  id                           String                @id @default(cuid())
  email                        String                @unique
  name                         String
  ringCentralPhoneNumber       String?
  ringCentralExtensionId       String?
  ringCentralCallerId          String?
  ringCentralJwt               String?
  emailSignature               String?
  timezone                     String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  avatar                       UserAvatar?
  memberships                  WorkspaceMember[]
  createdJobs                  LeadJob[]             @relation("LeadJobCreator")
  ownedOpportunities           Opportunity[]         @relation("OpportunityOwner")
  ownedTasks                   Task[]                @relation("TaskOwner")
  createdTasks                 Task[]                @relation("TaskCreator")
  createdNotes                 Note[]                @relation("NoteCreator")
  callLogs                     CallLog[]
  managedSdrTeams              SdrTeam[]             @relation("SdrTeamManager")
  assignedSdrAssignments       SdrAssignment[]       @relation("AssignedSdr")
  createdSdrAssignments        SdrAssignment[]       @relation("AssignmentCreator")
  ownedFollowUpReminders       FollowUpReminder[]    @relation("ReminderOwner")
  ownedOutreachCampaigns       OutreachCampaign[]    @relation("CampaignOwner")
  createdCampaignSequences     CampaignSequence[]    @relation("SequenceCreator")
  smsEvents                    SmsEvent[]
  trackedCalls                 TrackedCall[]
  sdrCallingSessions           SdrCallingSession[]
  sdrDailyReports              SdrDailyReport[]
  activities                   Activity[]
  generatedReportSnapshots     ReportSnapshot[]      @relation("ReportSnapshotGenerator")
  retentionRuns                RetentionRun[]        @relation("RetentionRunActor")
  resolvedDeliverabilityAlerts DeliverabilityAlert[] @relation("DeliverabilityAlertResolver")
  handledDataSubjectRequests   DataSubjectRequest[]  @relation("DataSubjectRequestHandler")
  generatedAiPersonalizations  AiPersonalization[]   @relation("AiPersonalizationGenerator")
  createdAiIcpRecommendations  AiIcpRecommendation[] @relation("AiIcpRecommendationCreator")
  aiAutomationRuns             AiAutomationRun[]     @relation("AiAutomationRunActor")
  auditLogs                    AuditLog[]
  authAccount                  AuthAccount?
  authSessions                 AuthSession[]
  sentUserInvites              UserInvite[]          @relation("UserInviteSender")
  passwordResetTokens          PasswordResetToken[]
}

// Profile picture bytes, kept OUT of the AppState blob (which is on the hot read
// path) and out of the normalized projection — managed directly by the profile
// avatar upload/serve routes. Served via GET /api/profile/avatar/[userId].
model UserAvatar {
  userId      String   @id
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model AuthAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String    @unique
  passwordHash      String
  status            String
  emailVerifiedAt   DateTime?
  passwordUpdatedAt DateTime?
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  mfaEnabled        Boolean   @default(false)
  superadmin        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([superadmin])
}

model AuthSession {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([workspaceId, expiresAt])
  @@index([revokedAt])
}

model UserInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String
  status      String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("UserInviteSender", fields: [invitedById], references: [id])

  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([usedAt])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  status      String
  trustScore  Int       @default(50)
  config      Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model ProviderConnection {
  id                 String                    @id @default(cuid())
  workspaceId        String
  providerId         String
  displayName        String
  status             String
  enabled            Boolean                   @default(false)
  executionMode      String                    @default("mock")
  categories         String[]
  capabilities       String[]
  scopes             String[]
  allowedOperations  String[]
  credentialLabel    String?
  secretRef          String?
  secretStorage      String                    @default("Not configured")
  secretVersion      Int                       @default(0)
  maskedSecretSuffix String?
  rateLimitPerMinute Int?
  dailyBudgetCents   Int?
  costPerUnitCents   Int?
  supportedCountries String[]                  @default([])
  waterfallOrder     Int                       @default(0)
  lastTestStatus     String                    @default("Not tested")
  lastTestedAt       DateTime?
  lastTestedById     String?
  lastTestError      String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentialAudits   ProviderCredentialAudit[]
  encryptedSecrets   ProviderEncryptedSecret[]
  providerJobs       ProviderJob[]
  providerJobRuns    ProviderJobRun[]

  @@unique([workspaceId, providerId])
  @@index([workspaceId, status])
  @@index([workspaceId, enabled])
}

model ProviderCredentialAudit {
  id                   String             @id @default(cuid())
  workspaceId          String
  providerConnectionId String
  providerId           String
  actorUserId          String?
  action               String
  secretVersion        Int                @default(0)
  redactedMetadata     Json
  createdAt            DateTime           @default(now())
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, providerId, createdAt])
  @@index([workspaceId, providerConnectionId])
}

model ProviderEncryptedSecret {
  id                   String             @id @default(cuid())
  workspaceId          String
  providerConnectionId String
  providerId           String
  secretRef            String             @unique
  secretVersion        Int                @default(0)
  storage              String             @default("Encrypted database")
  algorithm            String
  keyId                String
  ciphertext           String
  iv                   String
  authTag              String
  checksum             String
  rotatedFromSecretRef String?
  createdById          String?
  createdAt            DateTime           @default(now())
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@unique([providerConnectionId, secretVersion])
  @@index([workspaceId, providerId, secretVersion])
  @@index([workspaceId, providerConnectionId])
}

model ProviderJob {
  id                   String             @id @default(cuid())
  workspaceId          String
  providerConnectionId String
  providerId           String
  operation            String
  status               String
  priority             Int                @default(5)
  idempotencyKey       String
  requestHash          String
  sourceObjectType     String?
  sourceObjectId       String?
  inputSummary         Json
  resultSummary        Json?
  recordsRead          Int                @default(0)
  recordsWritten       Int                @default(0)
  costCents            Int                @default(0)
  errorMessage         String?
  maxAttempts          Int                @default(3)
  queuedAt             DateTime
  startedAt            DateTime?
  completedAt          DateTime?
  nextRetryAt          DateTime?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  runs                 ProviderJobRun[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, providerId, operation, status])
  @@index([workspaceId, status, priority])
  @@index([workspaceId, sourceObjectType, sourceObjectId])
}

model ProviderJobRun {
  id                   String             @id @default(cuid())
  workspaceId          String
  providerJobId        String
  providerConnectionId String
  providerId           String
  operation            String
  status               String
  attempt              Int                @default(1)
  maxAttempts          Int                @default(3)
  idempotencyKey       String
  providerRequestId    String
  providerRunId        String?
  waterfallTemplateId  String?
  waterfallStepId      String?
  leadTargetType       String?
  leadTargetId         String?
  checkpoint           Json?
  requestSummary       Json?
  responseSummary      Json?
  rawResponseRef       String?
  recordsRead          Int                @default(0)
  recordsWritten       Int                @default(0)
  costCents            Int                @default(0)
  durationMs           Int?
  errorMessage         String?
  lockedBy             String?
  lockedAt             DateTime?
  lockExpiresAt        DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  nextRetryAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  providerJob          ProviderJob        @relation(fields: [providerJobId], references: [id], onDelete: Cascade)

  @@unique([providerJobId, attempt])
  @@index([workspaceId, providerId, operation, status])
  @@index([workspaceId, providerJobId])
  @@index([workspaceId, status, nextRetryAt])
  @@index([workspaceId, status, lockExpiresAt])
}

model ProviderUsageLedger {
  id                  String    @id @default(cuid())
  workspaceId         String
  provider            String
  operation           String
  jobId               String?
  providerJobId       String?
  providerJobRunId    String?
  unitsUsed           Int       @default(0)
  unitCostCents       Int       @default(0)
  totalCostCents      Int       @default(0)
  currency            String    @default("USD")
  amountKind          String
  rawProviderMetadata Json
  createdAt           DateTime  @default(now())
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, operation, createdAt])
  @@index([workspaceId, jobId])
  @@index([workspaceId, providerJobId])
  @@index([workspaceId, providerJobRunId])
}

model ProviderMetricDaily {
  id               String    @id @default(cuid())
  workspaceId      String
  providerId       String
  capability       String
  date             DateTime
  attempts         Int       @default(0)
  hits             Int       @default(0)
  valid            Int       @default(0)
  failures         Int       @default(0)
  mobileCount      Int       @default(0)
  companyMainCount Int       @default(0)
  wrongNumber      Int       @default(0)
  bounces          Int       @default(0)
  costCents        Int       @default(0)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId, capability, date])
  @@index([workspaceId, providerId, capability])
  @@index([workspaceId, date])
}

model SearchProfile {
  id                String    @id @default(cuid())
  workspaceId       String
  profileName       String
  targetMarket      String?
  targetIndustries  String[]
  targetGeographies String[]
  targetTitles      String[]
  requiredFields    String[]
  excludedKeywords  String[]
  excludedDomains   String[]
  sourcePreferences Json
  scoringProfile    String?
  segmentRules      Json
  defaultRouting    Json?
  complianceNotes   String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadJobs          LeadJob[]

  @@index([workspaceId, profileName])
}

model LeadJob {
  id                      String          @id @default(cuid())
  workspaceId             String
  searchProfileId         String?
  jobName                 String
  selectedSources         String[]
  sourceConfigs           Json
  status                  JobStatus       @default(DRAFT)
  priority                String          @default("normal")
  estimatedRecords        Int             @default(0)
  rawRecordsCount         Int             @default(0)
  normalizedRecordsCount  Int             @default(0)
  duplicateRecordsCount   Int             @default(0)
  suppressedRecordsCount  Int             @default(0)
  verifiedEmailCount      Int             @default(0)
  verifiedPhoneCount      Int             @default(0)
  enrichedRecordsCount    Int             @default(0)
  exportedRecordsCount    Int             @default(0)
  pushedToCrmCount        Int             @default(0)
  failedRecordsCount      Int             @default(0)
  estimatedCostCents      Int             @default(0)
  estimatedCredits        Int             @default(0)
  budgetCapCents          Int?
  budgetStatus            String?
  budgetConfirmedAt       DateTime?
  budgetConfirmedById     String?
  enrichmentBudgetCents   Int?
  highValueOnlyEnrichment Boolean         @default(false)
  waterfallTemplateId     String?
  waterfallOverride       Json?
  actualCostCents         Int             @default(0)
  complianceNotes         String?
  errorSummary            String?
  createdById             String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searchProfile           SearchProfile?  @relation(fields: [searchProfileId], references: [id])
  createdBy               User?           @relation("LeadJobCreator", fields: [createdById], references: [id])
  sourceRuns              LeadJobSource[]
  rawLeads                RawLead[]
  exports                 Export[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model LeadJobSource {
  id               String    @id @default(cuid())
  leadJobId        String
  source           String
  config           Json
  status           JobStatus @default(QUEUED)
  providerCursor   String?
  requestMetadata  Json?
  responseMetadata Json?
  creditUsage      Int       @default(0)
  checkpoint       Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  leadJob          LeadJob   @relation(fields: [leadJobId], references: [id], onDelete: Cascade)

  @@unique([leadJobId, source])
}

model AsyncJobRun {
  id             String    @id @default(cuid())
  workspaceId    String
  leadJobId      String
  source         String
  status         String
  attempt        Int       @default(1)
  maxAttempts    Int       @default(3)
  providerRunId  String
  idempotencyKey String
  checkpoint     Json?
  creditUsage    Int       @default(0)
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  nextRetryAt    DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey, attempt])
  @@index([workspaceId, leadJobId, status])
  @@index([workspaceId, status, nextRetryAt])
}

model JobLog {
  id          String    @id @default(cuid())
  workspaceId String
  leadJobId   String
  runId       String?
  level       String
  message     String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadJobId, createdAt])
  @@index([workspaceId, level, createdAt])
}

model JobIdempotencyRecord {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  scope       String
  requestHash String
  leadJobId   String
  status      String
  recordIds   String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, leadJobId, scope])
  @@index([workspaceId, status])
}

model RawLead {
  id               String            @id @default(cuid())
  workspaceId      String
  leadJobId        String
  source           String
  sourceRecordId   String
  sourcePayload    Json
  sourceUrl        String?
  sourceConfidence Int?
  extractedAt      DateTime          @default(now())
  processingStatus ProcessingStatus  @default(PENDING)
  processingError  String?
  normalizedRecord NormalizedRecord?
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadJob          LeadJob           @relation(fields: [leadJobId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, sourceRecordId])
  @@index([workspaceId, leadJobId])
}

model NormalizedRecord {
  id                String    @id @default(cuid())
  workspaceId       String
  rawLeadId         String    @unique
  leadJobId         String?
  companyName       String?
  normalizedName    String?
  domain            String?
  website           String?
  contactName       String?
  title             String?
  seniority         String?
  email             String?
  phone             String?
  city              String?
  state             String?
  country           String?
  linkedinUrl       String?
  industry          String?
  technology        String[]
  grade             String?
  score             Int       @default(0)
  priority          String?
  status            String?
  segment           String?
  owner             String?
  verification      String?
  suppressionReason String?
  normalizedAt      DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rawLead           RawLead   @relation(fields: [rawLeadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, domain])
  @@index([workspaceId, email])
  @@index([workspaceId, leadJobId])
}

model Company {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  normalizedName String
  rootDomain     String?
  website        String?
  linkedinUrl    String?
  googlePlaceId  String?
  phone          String?
  industry       String?
  employeeBand   String?
  revenueBand    String?
  city           String?
  state          String?
  country        String?
  sourceLineage  Json
  confidence     Int           @default(50)
  score          Int           @default(0)
  priority       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  fieldSources   FieldSource[]
  account        Account?

  @@index([workspaceId, rootDomain])
  @@index([workspaceId, normalizedName])
}

model Contact {
  id                  String               @id @default(cuid())
  workspaceId         String
  companyId           String?
  fullName            String
  title               String?
  seniority           String?
  department          String?
  email               String?
  phone               String?
